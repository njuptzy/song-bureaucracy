# OpenAI 兼容端点配置。默认使用 OpenCode Go 的 DeepSeek V4 Flash。

# --- 默认：OpenCode Go ---
# 在 https://opencode.ai/auth 获取 Go API key。
LLM_PROFILE=opencode_go
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
OPENCODE_GO_MODEL=deepseek-v4-flash
OPENCODE_GO_MAX_TOKENS=16384
OPENCODE_GO_STREAM=1

# --- 可选：OpenRouter ---
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_MAX_TOKENS=16384

# --- 可选：FreeModel GPT-5.5 ---
# FREEMODEL_API_KEY=your_freemodel_api_key_here
# FREEMODEL_BASE_URL=https://api.freemodel.dev/v1/chat/completions
# FREEMODEL_MODEL=gpt-5.5
# FREEMODEL_MAX_TOKENS=16384
# FREEMODEL_EXTRA_BODY={"model_reasoning_effort":"xhigh","disable_response_storage":true}

# Optional database overrides.
# SONG_DICT_DB_PATH=/absolute/path/to/song_bureaucracy_dictionary.db
# SONG_ENTRY_DB_PATH=/absolute/path/to/song_bureaucracy_entries.db
# SONG_DICT_TABLE=chapter8t10
