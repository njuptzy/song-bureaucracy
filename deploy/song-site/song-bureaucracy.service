[Unit]
Description=Song bureaucracy visualization
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=songvis
Group=songvis
WorkingDirectory=/opt/song-bureaucracy/current/vis/ch1t12-design-vis
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3.11 /opt/song-bureaucracy/current/vis/ch1t12-design-vis/server.py --host 127.0.0.1 --port 8650 --entries-db /var/lib/song-bureaucracy/song_bureaucracy_entries_ch1t12.db --dict-db /var/lib/song-bureaucracy/song_bureaucracy_dictionary_ch1t12.db --dict-table chapter1t12 --revisions-db /var/lib/song-bureaucracy/song_bureaucracy_entries_ch1t12.revisions.db
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/song-bureaucracy

[Install]
WantedBy=multi-user.target
