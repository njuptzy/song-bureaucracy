[Unit]
Description=Song bureaucracy visualization
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=songvis
Group=songvis
WorkingDirectory=/opt/song-bureaucracy/current/vis/ch2t7-design-vis
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/song-bureaucracy/current/vis/ch2t7-design-vis/server.py --host 127.0.0.1 --port 8650 --entries-db /opt/song-bureaucracy/current/data/database/song_bureaucracy_entries_ch2t7.db --dict-db /opt/song-bureaucracy/current/data/database/song_bureaucracy_dictionary_ch2t7.db --dict-table chapter2t7 --revisions-db /var/lib/song-bureaucracy/song_bureaucracy_entries_ch2t7.revisions.db
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/song-bureaucracy

[Install]
WantedBy=multi-user.target
